PREFIX schema: <http://schema.org/>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX dataid: <https://dataid.dbpedia.org/ns/core#>

SELECT ?g ?sourceSlug ?keyword (COUNT(DISTINCT ?event) AS ?eventCount)
WHERE {
  GRAPH ?g {
    ?event a schema:Event ;
           schema:keywords ?keyword .
  }
  OPTIONAL {
    ?g prov:wasDerivedFrom/foaf:primaryTopic ?dataset .
    ?dataset dataid:group ?group .
    BIND(STRAFTER(STR(?group), "databus/capacoa/") AS ?sourceSlug)
  }
}
GROUP BY ?g ?sourceSlug ?keyword
ORDER BY ?g DESC(?eventCount)
