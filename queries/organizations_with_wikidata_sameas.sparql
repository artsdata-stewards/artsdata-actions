# Artsdata organizations (ado:Organization) linked with schema:sameAs to Wikidata
PREFIX ado: <http://kg.artsdata.ca/ontology/>
PREFIX schema: <http://schema.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT
?ArtsdataID
?WikidataID
(SAMPLE(?label) AS ?name)
(SAMPLE(?location) AS ?location_uri)
(SAMPLE(?locationName) AS ?location_name)
(SAMPLE(?streetAddress) AS ?street_address)
(SAMPLE(?addressLocality) AS ?address_locality)
(SAMPLE(?addressRegion) AS ?address_region)
(SAMPLE(?postalCode) AS ?postal_code)
(SAMPLE(?addressCountry) AS ?address_country)
# true when none of the PostalAddress properties are filled
((COUNT(?streetAddress) + COUNT(?addressLocality) + COUNT(?addressRegion) + COUNT(?postalCode) + COUNT(?addressCountry)) = 0 AS ?missing_address)
WHERE {
    ?ArtsdataID a ado:Organization ;
        schema:sameAs ?WikidataID .
    FILTER(STRSTARTS(STR(?ArtsdataID), "http://kg.artsdata.ca/resource/K"))
    FILTER(STRSTARTS(STR(?WikidataID), "http://www.wikidata.org/entity/"))
    OPTIONAL {
        ?ArtsdataID rdfs:label ?labelMul .
        FILTER(LANG(?labelMul) = "mul")
    }
    OPTIONAL {
        ?ArtsdataID rdfs:label ?labelEn .
        FILTER(LANG(?labelEn) = "en")
    }
    OPTIONAL {
        ?ArtsdataID rdfs:label ?labelFr .
        FILTER(LANG(?labelFr) = "fr")
    }
    OPTIONAL {
        ?ArtsdataID rdfs:label ?labelNone .
        FILTER(LANG(?labelNone) = "")
    }
    BIND(COALESCE(?labelMul, ?labelEn, ?labelFr, ?labelNone) AS ?label)
    OPTIONAL {
        ?ArtsdataID schema:location ?location .
        OPTIONAL { ?location schema:name ?locationName . }
    }
    # Address directly on the organization, or on its location
    OPTIONAL {
        ?ArtsdataID schema:address|schema:location/schema:address ?address .
        OPTIONAL { ?address schema:streetAddress ?streetAddress . }
        OPTIONAL { ?address schema:addressLocality ?addressLocality . }
        OPTIONAL { ?address schema:addressRegion ?addressRegion . }
        OPTIONAL { ?address schema:postalCode ?postalCode . }
        OPTIONAL { ?address schema:addressCountry ?addressCountry . }
    }
}
GROUP BY ?ArtsdataID ?WikidataID
ORDER BY DESC(?missing_address) ?name
