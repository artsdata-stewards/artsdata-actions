PREFIX schema: <http://schema.org/>
PREFIX skos:   <http://www.w3.org/2004/02/skos/core#>
PREFIX owl:    <http://www.w3.org/2002/07/owl#>
PREFIX adr:    <http://kg.artsdata.ca/resource/>

SELECT
  ?FootlightCMS
  ?artsdataType
  (COUNT(DISTINCT ?event) AS ?eventCount)

WHERE {

  VALUES (?g ?FootlightCMS) {
    (<http://kg.artsdata.ca/culture-creates/artsdata-planet-footlight/indigenous-performances>
     "Indigenous Performances")
    (<http://kg.artsdata.ca/culture-creates/artsdata-planet-footlight/signe-laval>
     "Signé Laval")
    (<http://kg.artsdata.ca/culture-creates/artsdata-planet-footlight/tout-culture>
     "Tout Culture")
  }

  GRAPH ?g {
    ?event a schema:Event ; schema:additionalType ?footlightTerm .
    ?footlightTerm skos:broader*/skos:closeMatch ?artsdataType .
    
  }

} group by ?g  ?FootlightCMS ?artsdataType 
